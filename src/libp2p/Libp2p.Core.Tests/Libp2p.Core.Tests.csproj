<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnablePreviewFeatures>true</EnablePreviewFeatures>
    <RootNamespace>Nethermind.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <AssemblyName>Nethermind.$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Libp2p.Core.TestsBase\Libp2p.Core.TestsBase.csproj" />
    <ProjectReference Include="..\Libp2p\Libp2p.csproj" />
    <ProjectReference Include="..\Libp2p.Protocols.Ping\Libp2p.Protocols.Ping.csproj" />
  </ItemGroup>

  <!-- The default stack's quic-v1 is the quiche transport, so the
       end-to-end tests that run the default stack need the native
       libquiche staged next to the test assembly, exactly as the
       Quiche.Tests project stages it. Override with
       /p:QuicheNetDir=. -->
  <PropertyGroup>
    <QuicheNetDir Condition="'$(QuicheNetDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\quiche-dotnet\</QuicheNetDir>
  </PropertyGroup>

  <Target Name="StageQuicheNative" AfterTargets="Build">
    <ItemGroup>
      <QuicheNativeFiles Include="$(QuicheNetDir)native\out\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(QuicheNativeFiles)"
          DestinationFiles="@(QuicheNativeFiles->'$(OutputPath)runtimes\%(RecursiveDir)native\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
