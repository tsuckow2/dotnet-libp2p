<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Nethermind.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Nethermind.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Quiche.NET is not published yet (its step 5); until then the
         transport builds against a checkout at the repository root
         (see README.md). Override with
         /p:QuicheNetDir=/path/to/quiche-dotnet/ for other layouts. -->
    <QuicheNetDir Condition="'$(QuicheNetDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\quiche-dotnet\</QuicheNetDir>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>libp2p network quic</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\cs-multihash\src\Multiformats.Hash\Multiformats.Hash.csproj" />
    <ProjectReference Include="..\..\Libp2p.Core\Libp2p.Core.csproj" />
    <ProjectReference Include="$(QuicheNetDir)src\Quiche.NET\Quiche.NET.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
